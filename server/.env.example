# Neon connection string (Dashboard > Connection Details). Keep ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password the organizers type to open /admin
ADMIN_PASSWORD=change-me

# Long random string used to sign admin login tokens (e.g. run: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Allowed website origins, comma separated. Use your Vercel URL(s).
# A wildcard works too, e.g. https://brigade2026-*.vercel.app for preview deploys.
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
